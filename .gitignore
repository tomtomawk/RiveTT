# Build output
bin/
obj/
.vs/
*.user
*.suo
release/
publish/

# Generated build output (builder/build.ps1 rebuilds all of it; never commit
# binaries). Two trees, and the split is deliberate: builder/staging/ holds the
# intermediate payload ISCC reads, dist/ holds only what is publishable as it
# stands. The versioned SOURCES are builder/build.ps1 and
# builder/installer/RiveTT.iss; src/resources/documentation/ is versioned too --
# it is product content, copied into staging at build time, not generated.
builder/staging/
dist/

# Local run logs from deploy/install scripts
/*.log

# Claude Code local state (settings.local.json is tracked intentionally)
.claude/
.claude/scheduled_tasks.lock
.claude/worktrees/
.worktrees/

# Artifacts generated by AI test sessions under docs/ — never source
docs/*.xlsx
docs/*.csv
docs/*.json
docs/gen_*.py
docs/check_*.py

# Ad-hoc screenshots and publish temp dirs
/*.png
/*.jpg
.publish-smoke/

